<?xml version="1.0" encoding="utf-8"?>
<!-- Android 11 and lower. allowBackup="false" already disables Android backup;
     this file makes the intent explicit: no BizBill data is backed up by Android. -->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
