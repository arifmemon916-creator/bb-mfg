<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+. Business data (WebView storage with invoices, customers,
     products, payments, settings), local backup files, caches and preferences
     are excluded from BOTH Google cloud backup and device-to-device transfer.
     Users move data with BizBill's own (optionally password-encrypted) backup. -->
<data-extraction-rules>
    <cloud-backup disableIfNoEncryptionCapabilities="true">
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
