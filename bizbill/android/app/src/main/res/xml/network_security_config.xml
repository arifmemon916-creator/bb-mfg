<?xml version="1.0" encoding="utf-8"?>
<!-- HTTPS only, system certificate authorities only (user-installed CAs are
     not trusted, which blocks interception of update downloads). -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
